# Required: URL of your Open Brain REST API
NEXT_PUBLIC_API_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/open-brain-rest

# Required: 32+ character secret for iron-session cookie encryption
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: SHA-256 hash of passphrase to unlock restricted/sensitive content
# Requires the sensitivity-tiers primitive (sensitivity_tier column on thoughts)
# Generate with: echo -n "your-passphrase" | shasum -a 256
# RESTRICTED_PASSPHRASE_HASH=

# ── Plaud speaker-review GUI (/speakers) — OPTIONAL ─────────────────────────
# Filesystem root where Applaud stores recordings on THIS machine (the dashboard
# streams audio.ogg from here to the GUI with HTTP range/seek — nothing is copied
# to the cloud). Machine path — keep the real value in .env.local, not in git.
# APPLAUD_RECORDINGS_DIR=C:\Users\YOUR_USER\projects\Applaud\recordings

# The WSL voiceprint-library enrolment endpoint. Called ONLY from this local
# dashboard server (it can reach the WSL box; the Edge Function cannot). When a
# speaker is bulk-renamed in /speakers, that voice is enrolled to the on-box
# library. Unset ⇒ labels still save, enrolment is skipped.
# WSL_PIPELINE_ENROL_URL=http://127.0.0.1:9010/enrol

# The WSL pipeline's analysis trigger. Called from this local dashboard on RELEASE
# (mark-reviewed in /speakers) so terra analysis runs ONLY on operator-confirmed
# recordings, not at ingest. Unset ⇒ release still works, analysis not auto-fired.
# WSL_PIPELINE_ANALYZE_URL=http://localhost:8799/analyze

# WSL voiceprint relabel endpoint (scope one|all) — supersedes /enrol. Called from
# this local dashboard on a speaker rename to move voiceprint(s) into the library +
# recompute centroids + heal the moved-off speaker. Per-line corrections learn too.
# WSL_PIPELINE_RELABEL_URL=http://localhost:8799/relabel

# WSL enrolled-voiceprint names endpoint — powers the /speakers rename typeahead
# (autocomplete to an existing name to avoid duplicate speakers). Local-only.
# WSL_PIPELINE_SPEAKERS_URL=http://localhost:8799/speakers

# Origins permitted to POST Server Actions in dev, when the dashboard is reached
# via a non-localhost hostname (Tailscale / LAN). Comma-separated hostnames/IPs;
# localhost + 127.0.0.1 always work without this. Leave empty for localhost-only.
# Example: 192.168.1.50,myhost,myhost.my-tailnet.ts.net,*.my-tailnet.ts.net
ALLOWED_DEV_ORIGINS=
